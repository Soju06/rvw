{
  "$defs": {
    "FindingCounts": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "default": 0,
          "minimum": 0,
          "title": "Blocker",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        },
        "suggestion": {
          "default": 0,
          "minimum": 0,
          "title": "Suggestion",
          "type": "integer"
        }
      },
      "title": "FindingCounts",
      "type": "object"
    },
    "PresentationConfig": {
      "additionalProperties": false,
      "description": "Base-ref presentation snapshot, safe to retain in strict run contracts.",
      "properties": {
        "display_name": {
          "default": "rvw",
          "maxLength": 80,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "short_name": {
          "default": "rvw",
          "maxLength": 40,
          "minLength": 1,
          "title": "Short Name",
          "type": "string"
        },
        "locale": {
          "default": "en",
          "enum": [
            "ko",
            "en"
          ],
          "title": "Locale",
          "type": "string"
        },
        "footer": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer"
        }
      },
      "title": "PresentationConfig",
      "type": "object"
    },
    "SummaryFailedLane": {
      "additionalProperties": false,
      "description": "One lane with a final INVALID planned execution and its normalized reason.",
      "properties": {
        "lane_id": {
          "minLength": 1,
          "title": "Lane Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "lane_id",
        "reason"
      ],
      "title": "SummaryFailedLane",
      "type": "object"
    },
    "SummaryLanes": {
      "additionalProperties": false,
      "properties": {
        "dispatched": {
          "default": 0,
          "minimum": 0,
          "title": "Dispatched",
          "type": "integer"
        },
        "valid": {
          "default": 0,
          "minimum": 0,
          "title": "Valid",
          "type": "integer"
        },
        "uncovered": {
          "default": 0,
          "minimum": 0,
          "title": "Uncovered",
          "type": "integer"
        }
      },
      "title": "SummaryLanes",
      "type": "object"
    },
    "VerdictCounts": {
      "additionalProperties": false,
      "properties": {
        "CONFIRMED": {
          "default": 0,
          "minimum": 0,
          "title": "Confirmed",
          "type": "integer"
        },
        "REJECTED": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "UNCERTAIN": {
          "default": 0,
          "minimum": 0,
          "title": "Uncertain",
          "type": "integer"
        }
      },
      "title": "VerdictCounts",
      "type": "object"
    },
    "WaveWallSeconds": {
      "additionalProperties": false,
      "description": "Longest runtime wall per executed pipeline wave; null when the wave did not run.",
      "properties": {
        "discovery_initial": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Initial"
        },
        "discovery_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Retry"
        },
        "discovery_redispatch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Redispatch"
        },
        "adjudication_initial": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Initial"
        },
        "adjudication_initial_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Initial Retry"
        },
        "adjudication_expanded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Expanded"
        },
        "adjudication_expanded_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Expanded Retry"
        }
      },
      "title": "WaveWallSeconds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "publication_failure": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Failure"
    },
    "language_fallback_used": {
      "default": false,
      "title": "Language Fallback Used",
      "type": "boolean"
    },
    "presentation": {
      "$ref": "#/$defs/PresentationConfig"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lanes": {
      "$ref": "#/$defs/SummaryLanes"
    },
    "failed_lanes": {
      "items": {
        "$ref": "#/$defs/SummaryFailedLane"
      },
      "title": "Failed Lanes",
      "type": "array"
    },
    "wave_wall_seconds": {
      "$ref": "#/$defs/WaveWallSeconds"
    },
    "findings": {
      "$ref": "#/$defs/FindingCounts"
    },
    "verdicts": {
      "$ref": "#/$defs/VerdictCounts"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "markdown": {
      "default": "Review has not completed.",
      "title": "Markdown",
      "type": "string"
    }
  },
  "title": "ExecutionSummary",
  "type": "object"
}
