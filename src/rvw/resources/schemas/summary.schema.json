{
  "$defs": {
    "FindingCounts": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "default": 0,
          "minimum": 0,
          "title": "Blocker",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        },
        "suggestion": {
          "default": 0,
          "minimum": 0,
          "title": "Suggestion",
          "type": "integer"
        }
      },
      "title": "FindingCounts",
      "type": "object"
    },
    "InlinePolicyFacts": {
      "additionalProperties": false,
      "properties": {
        "severity_at_least": {
          "default": "suggestion",
          "enum": [
            "suggestion",
            "warning",
            "blocker"
          ],
          "title": "Severity At Least",
          "type": "string"
        },
        "max_comments": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Comments"
        },
        "body_only_count": {
          "default": 0,
          "minimum": 0,
          "title": "Body Only Count",
          "type": "integer"
        }
      },
      "title": "InlinePolicyFacts",
      "type": "object"
    },
    "PresentationConfig": {
      "additionalProperties": false,
      "description": "Base-ref presentation snapshot, safe to retain in strict run contracts.",
      "properties": {
        "display_name": {
          "default": "rvw",
          "maxLength": 80,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "short_name": {
          "default": "rvw",
          "maxLength": 40,
          "minLength": 1,
          "title": "Short Name",
          "type": "string"
        },
        "locale": {
          "default": "en",
          "enum": [
            "ko",
            "en"
          ],
          "title": "Locale",
          "type": "string"
        },
        "footer": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer"
        },
        "voice": {
          "$ref": "#/$defs/VoiceConfig"
        },
        "synthesis": {
          "$ref": "#/$defs/SynthesisConfig"
        }
      },
      "title": "PresentationConfig",
      "type": "object"
    },
    "PublishFacts": {
      "additionalProperties": false,
      "description": "What publication did on GitHub: the event, and every thread and review it touched.",
      "properties": {
        "channels": {
          "default": [
            "checks",
            "review"
          ],
          "items": {
            "enum": [
              "checks",
              "review"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "inline_policy": {
          "$ref": "#/$defs/InlinePolicyFacts"
        },
        "event": {
          "anyOf": [
            {
              "enum": [
                "COMMENT",
                "REQUEST_CHANGES",
                "APPROVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "policy_source": {
          "anyOf": [
            {
              "enum": [
                "default",
                "repository",
                "explicit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Source"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "event_clamped_reason": {
          "anyOf": [
            {
              "enum": [
                "no_verdict",
                "no_adjudication",
                "degraded",
                "login_unknown",
                "read_failed",
                "snapshot_unverified",
                "event_override"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Clamped Reason"
        },
        "dismissed_review_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Dismissed Review Ids",
          "type": "array"
        },
        "dismiss_failed_review_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Dismiss Failed Review Ids",
          "type": "array"
        },
        "resolved_thread_ids": {
          "items": {
            "type": "string"
          },
          "title": "Resolved Thread Ids",
          "type": "array"
        },
        "reused_thread_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reused Thread Ids",
          "type": "array"
        },
        "superseded_thread_ids": {
          "items": {
            "type": "string"
          },
          "title": "Superseded Thread Ids",
          "type": "array"
        },
        "threads_ambiguous": {
          "items": {
            "type": "string"
          },
          "title": "Threads Ambiguous",
          "type": "array"
        },
        "threads_skipped_lane_invalid": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Lane Invalid",
          "type": "array"
        },
        "threads_skipped_resolved": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Resolved",
          "type": "array"
        },
        "threads_skipped_same_head": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Same Head",
          "type": "array"
        },
        "threads_skipped_human_reply": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Human Reply",
          "type": "array"
        },
        "threads_skipped_unverified": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Unverified",
          "type": "array"
        },
        "threads_skipped_uncovered": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Uncovered",
          "type": "array"
        },
        "threads_skipped_missing": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Missing",
          "type": "array"
        },
        "threads_skipped_write_failed": {
          "items": {
            "type": "string"
          },
          "title": "Threads Skipped Write Failed",
          "type": "array"
        },
        "threads_skipped_reason": {
          "anyOf": [
            {
              "enum": [
                "login_unknown",
                "read_failed",
                "degraded",
                "forbidden",
                "write_failed",
                "disabled_by_policy",
                "not_planned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threads Skipped Reason"
        }
      },
      "title": "PublishFacts",
      "type": "object"
    },
    "SummaryFailedLane": {
      "additionalProperties": false,
      "description": "One lane with a final INVALID planned execution and its normalized reason.",
      "properties": {
        "lane_id": {
          "minLength": 1,
          "title": "Lane Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "lane_id",
        "reason"
      ],
      "title": "SummaryFailedLane",
      "type": "object"
    },
    "SummaryLanes": {
      "additionalProperties": false,
      "properties": {
        "dispatched": {
          "default": 0,
          "minimum": 0,
          "title": "Dispatched",
          "type": "integer"
        },
        "valid": {
          "default": 0,
          "minimum": 0,
          "title": "Valid",
          "type": "integer"
        },
        "uncovered": {
          "default": 0,
          "minimum": 0,
          "title": "Uncovered",
          "type": "integer"
        },
        "uncovered_regions": {
          "default": 0,
          "minimum": 0,
          "title": "Uncovered Regions",
          "type": "integer"
        }
      },
      "title": "SummaryLanes",
      "type": "object"
    },
    "SynthesisConfig": {
      "additionalProperties": false,
      "description": "Repository-selected synthesis execution setting.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "SynthesisConfig",
      "type": "object"
    },
    "SynthesisFacts": {
      "additionalProperties": false,
      "description": "Non-judgmental health and runtime facts for the synthesis pass.",
      "properties": {
        "status": {
          "default": "fallback:not-run",
          "title": "Status",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Seconds"
        },
        "tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "title": "SynthesisFacts",
      "type": "object"
    },
    "VerdictCounts": {
      "additionalProperties": false,
      "properties": {
        "CONFIRMED": {
          "default": 0,
          "minimum": 0,
          "title": "Confirmed",
          "type": "integer"
        },
        "REJECTED": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "UNCERTAIN": {
          "default": 0,
          "minimum": 0,
          "title": "Uncertain",
          "type": "integer"
        }
      },
      "title": "VerdictCounts",
      "type": "object"
    },
    "VoiceConfig": {
      "additionalProperties": false,
      "description": "Repository-selected reviewer voice used only for presentation.",
      "properties": {
        "audience": {
          "default": "engineers",
          "enum": [
            "engineers",
            "mixed"
          ],
          "title": "Audience",
          "type": "string"
        },
        "register": {
          "default": "formal",
          "enum": [
            "formal",
            "neutral"
          ],
          "title": "Register",
          "type": "string"
        },
        "guidance": {
          "anyOf": [
            {
              "maxLength": 800,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidance"
        },
        "examples": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Examples",
          "type": "array"
        },
        "allowed_terms": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Terms",
          "type": "array"
        }
      },
      "title": "VoiceConfig",
      "type": "object"
    },
    "WaveWallSeconds": {
      "additionalProperties": false,
      "description": "Longest runtime wall per executed pipeline wave; null when the wave did not run.",
      "properties": {
        "discovery_initial": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Initial"
        },
        "discovery_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Retry"
        },
        "discovery_redispatch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Redispatch"
        },
        "adjudication_initial": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Initial"
        },
        "adjudication_initial_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Initial Retry"
        },
        "adjudication_expanded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Expanded"
        },
        "adjudication_expanded_retry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Expanded Retry"
        }
      },
      "title": "WaveWallSeconds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "publication_failure": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Failure"
    },
    "language_fallback_used": {
      "default": false,
      "title": "Language Fallback Used",
      "type": "boolean"
    },
    "publication_skipped": {
      "anyOf": [
        {
          "enum": [
            "duplicate_review_same_head",
            "on_pass_none",
            "head_moved",
            "review_channel_disabled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Skipped"
    },
    "presentation": {
      "$ref": "#/$defs/PresentationConfig"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lanes": {
      "$ref": "#/$defs/SummaryLanes"
    },
    "failed_lanes": {
      "items": {
        "$ref": "#/$defs/SummaryFailedLane"
      },
      "title": "Failed Lanes",
      "type": "array"
    },
    "wave_wall_seconds": {
      "$ref": "#/$defs/WaveWallSeconds"
    },
    "findings": {
      "$ref": "#/$defs/FindingCounts"
    },
    "verdicts": {
      "$ref": "#/$defs/VerdictCounts"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "markdown": {
      "default": "Review has not completed.",
      "title": "Markdown",
      "type": "string"
    },
    "publish": {
      "$ref": "#/$defs/PublishFacts"
    },
    "synthesis": {
      "$ref": "#/$defs/SynthesisFacts"
    }
  },
  "title": "ExecutionSummary",
  "type": "object"
}
