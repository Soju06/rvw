{
  "name": "rvw",
  "url": "https://github.com/Soju06/rvw",
  "hook_attributes": {"url": "https://<worker-host>/github/webhook"},
  "redirect_url": "https://<worker-host>/github/callback",
  "public": false,
  "default_permissions": {"checks": "write", "pull_requests": "write", "contents": "read", "metadata": "read"},
  "default_events": ["pull_request", "check_run", "check_suite", "installation", "installation_repositories"]
}
